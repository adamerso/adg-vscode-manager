<Window x:Class="AdgVscodeManager.Views.InstallProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upgrade in Progress"
        Width="700" Height="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindow}"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <TextBlock x:Name="TitleText" 
                   Grid.Row="0"
                   Text="Upgrade in Progress" 
                   FontSize="20" 
                   FontWeight="SemiBold"
                   Foreground="{StaticResource ForegroundBrush}"
                   Margin="0,0,0,16"/>
        
        <!-- Version info -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="From" 
                           Foreground="#888888" 
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="FromVersionText" 
                           Text="1.85.0" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource ForegroundBrush}"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0">
                <TextBlock Text="→" 
                           FontSize="24" 
                           Foreground="#888888"/>
                <TextBlock x:Name="UpdateCountText" 
                           Text="3 versions" 
                           FontSize="12" 
                           Foreground="#888888"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <TextBlock Text="To" 
                           Foreground="#888888" 
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ToVersionText" 
                           Text="1.86.0" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>
        </Grid>
        
        <!-- Status and progress -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock x:Name="StatusText" 
                       Text="Preparing upgrade..."
                       Foreground="#AAAAAA"
                       Margin="0,0,0,8"/>
            <ProgressBar x:Name="ProgressBar" 
                         Height="8"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         IsIndeterminate="True"/>
        </StackPanel>
        
        <!-- Changelog preview -->
        <Border Grid.Row="3" 
                Background="{StaticResource SecondaryBrush}"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          Padding="12">
                <TextBox x:Name="ChangelogText"
                         Text="Changelog..."
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#999999"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>
            </ScrollViewer>
        </Border>
        
        <!-- Footer with status and OK button -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="FooterText" 
                       Text="This window will close automatically when complete."
                       Foreground="#666666"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="100"
                    Height="32"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed"
                    Style="{StaticResource ModernButton}"
                    Click="OkButton_Click"/>
        </Grid>
    </Grid>
</Window>
