<Window x:Class="AdgVscodeManager.Views.SetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdgVscodeManager"
        Title="{x:Static local:Constants.AppName}"
        Width="600" Height="720"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindow}"
        ResizeMode="NoResize">
    
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Welcome to ADG VSCode Manager" 
                       FontSize="24" 
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ForegroundBrush}"/>
            <TextBlock Text="No portable VSCode installation was found." 
                       Foreground="#AAAAAA"
                       Margin="0,8,0,0"/>
        </StackPanel>
        
        <!-- Channel selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Select VSCode channel to download:" 
                       Foreground="{StaticResource ForegroundBrush}"
                       FontSize="14"
                       Margin="0,0,0,16"/>
            
            <!-- Release option -->
            <Border x:Name="ReleaseBorder" 
                    Background="{StaticResource SecondaryBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12"
                    Cursor="Hand"
                    MouseDown="Release_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Ellipse Grid.Column="0" 
                             Width="48" Height="48"
                             Fill="#007ACC"
                             Margin="0,0,16,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="VSCode Release" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForegroundBrush}"/>
                        <TextBlock Text="Stable version, recommended for most users" 
                                   Foreground="#888888"
                                   FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Insiders option -->
            <Border x:Name="InsiderBorder" 
                    Background="{StaticResource SecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="16"
                    Cursor="Hand"
                    MouseDown="Insider_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Ellipse Grid.Column="0" 
                             Width="48" Height="48"
                             Fill="#2EA043"
                             Margin="0,0,16,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="VSCode Insiders" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForegroundBrush}"/>
                        <TextBlock Text="Preview builds with latest features (may be unstable)" 
                                   Foreground="#888888"
                                   FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        
        <!-- Info -->
        <Border Grid.Row="2" 
                Background="#252526"
                CornerRadius="4"
                Padding="12">
            <StackPanel>
                <TextBlock Text="⚠️ VSCode not found in expected location" 
                           Foreground="#FFCC00"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>
                
                <TextBlock Text="Expected directory structure:" 
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <TextBlock Text="📁 your-folder/" 
                           Foreground="#888888"
                           FontSize="12"
                           FontFamily="Consolas"/>
                <TextBlock Text="   ├── 📁 vscode-portable/  (or vscode-portable-insiders/)" 
                           Foreground="#4EC9B0"
                           FontSize="12"
                           FontFamily="Consolas"/>
                <TextBlock Text="   │      └── Code.exe" 
                           Foreground="#888888"
                           FontSize="12"
                           FontFamily="Consolas"/>
                <TextBlock Text="   ├── 📁 vscode-portable-manager-data/" 
                           Foreground="#888888"
                           FontSize="12"
                           FontFamily="Consolas"/>
                <TextBlock Text="   └── 🔷 AdgVscodeManager.exe  ← Manager location" 
                           Foreground="#569CD6"
                           FontSize="12"
                           FontFamily="Consolas"/>
                
                <TextBlock Text="" Margin="0,12,0,0"/>
                <TextBlock Text="Clicking 'Download &amp; Setup' will:" 
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <TextBlock Text="✓ Download the latest VSCode portable zip" 
                           Foreground="#888888"
                           FontSize="12"/>
                <TextBlock Text="✓ Create the correct directory structure" 
                           Foreground="#888888"
                           FontSize="12"/>
                <TextBlock Text="✓ Configure for portable mode with 'data' folder" 
                           Foreground="#888888"
                           FontSize="12"/>
            </StackPanel>
        </Border>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="CancelButton" 
                    Content="Cancel" 
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,12,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="DownloadButton" 
                    Content="Download &amp; Setup" 
                    Style="{StaticResource ModernButton}"
                    IsDefault="True"
                    Click="DownloadButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
