<Window x:Class="AdgVscodeManager.Views.AboutStatsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About and Statistics" 
        Width="500" 
        Height="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E1E1E"
        Foreground="White">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="ADG VSCode Manager"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        
        <!-- About Section -->
        <Border Grid.Row="2" 
                BorderBrush="#007ACC" 
                BorderThickness="1" 
                Padding="15"
                Background="#252526">
            <StackPanel>
                <TextBlock Text="About" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,10"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Version: " FontWeight="Bold" Width="80"/>
                    <TextBlock x:Name="VersionText"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="License: " FontWeight="Bold" Width="80"/>
                    <TextBlock Text="Mozilla Public License 2.0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Coding: " FontWeight="Bold" Width="80"/>
                    <TextBlock Text="Claude Opus"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Project: " FontWeight="Bold" Width="80"/>
                    <TextBlock Text="adamerso"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Statistics Section -->
        <Border Grid.Row="4" 
                BorderBrush="#007ACC" 
                BorderThickness="1" 
                Padding="15"
                Background="#252526">
            <StackPanel>
                <TextBlock Text="Statistics" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,10"/>
                
                <!-- Installed Updates -->
                <TextBlock Text="Installed Updates:" 
                           FontWeight="Bold" 
                           Margin="0,5,0,3"/>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                    <TextBlock Text="Count: " Width="70" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="InstalledCountText"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="15,2,0,5">
                    <TextBlock Text="Last: " Width="70" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="InstalledLastText"/>
                </StackPanel>
                
                <!-- Failed Updates -->
                <TextBlock Text="Failed Updates:" 
                           FontWeight="Bold" 
                           Margin="0,10,0,3"/>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                    <TextBlock Text="Count: " Width="70" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="FailedCountText"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="15,2,0,0">
                    <TextBlock Text="Last: " Width="70" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="FailedLastText"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="15,2,0,5">
                    <TextBlock Text="Reason: " Width="70" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="FailedReasonText" TextWrapping="Wrap"/>
                </StackPanel>
                
                <!-- Reverted Updates -->
                <TextBlock Text="Reverted Updates:" 
                           FontWeight="Bold" 
                           Margin="0,10,0,3"/>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                    <TextBlock Text="Count: " Width="70" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="RevertsCountText"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="15,2,0,5">
                    <TextBlock Text="Last: " Width="70" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="RevertsLastText"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Close Button -->
        <Button Grid.Row="6" 
                Content="Close" 
                Width="100" 
                Height="30"
                HorizontalAlignment="Center"
                Click="CloseButton_Click"
                Background="#007ACC"
                Foreground="White"
                BorderThickness="0"
                Margin="0,20,0,0"
                Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#005A9E"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
    </ScrollViewer>
</Window>
